# Copy to config/h3gen.env (gitignored) to override defaults from scripts/_env.sh.
# Machine-specific values (distro name, local folders) belong there, not in tracked files.

# WSL distro that scripts/wsl.ps1 runs in (unset = the WSL default distro). $env:H3_WSL_DISTRO wins over this.
#H3_WSL_DISTRO=Ubuntu-24.04

# Runtime folder inside WSL (ComfyUI, venv, downloaded models, logs, ComfyUI output). Keep it off /mnt/c.
#H3_RUNTIME=$HOME/h3-video-gen-runtime

# ComfyUI listen address/port. h3gen reads H3_HOST/H3_PORT (or H3_URL) too.
#H3_HOST=127.0.0.1
#H3_PORT=8190

# Existing ComfyUI model folder to reuse read-only (empty = none). Files found here are never re-downloaded.
#H3_SHARED_MODELS=$HOME/ComfyUI/models

# Download profile: minimal (2-step adapter only) or full (+4-step adapter)
#H3_PROFILE=minimal

# Pinned upstream versions
#COMFY_REF=v0.46.2
#PIFLOW_REF=bcb6ffb8ff
#TORCH_INDEX=https://download.pytorch.org/whl/cu130
